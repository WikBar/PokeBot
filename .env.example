# Wzorzec konfiguracji. Skopiuj jako .env i uzupełnij własnymi wartościami:
#   cp .env.example .env
# UWAGA: .env nigdy nie trafia do repozytorium (jest w .gitignore).

# Dane logowania do gry
POKE1_LOGIN=
POKE2_LOGIN=
POKE_PASSWORD=

# Klucz zabezpieczający API panelu web (dowolny losowy ciąg)
API_KEY=

# Port serwera panelu web
WEB_PORT=4001

# Tryb bez okna przeglądarki. Na VPS bez pulpitu ustaw true.
HEADLESS=false

# Powiadomienia o Golden Nest. Puste wartości = wysyłka wyłączona.
#
# Telegram — darmowy, bez limitów, najszybszy (używany w pierwszej kolejności).
# Konfiguracja jednorazowa:
#   1. Napisz do @BotFather: /newbot i podaj nazwę bota
#   2. Wklej otrzymany token poniżej
#   3. Napisz cokolwiek do swojego bota (np. /start)
#   4. Uruchom: npm run telegram:chatid — poda TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CallMeBot WhatsApp — zapas, używany tylko gdy pola Telegrama są puste.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Twilio (opcjonalnie, darmowe tylko w okresie próbnym).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=
